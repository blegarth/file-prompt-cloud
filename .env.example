# Google Cloud Project Configuration
PROJECT_ID=your-project-id
REGION=us-central1
SERVICE_NAME=cloud-run-service
SERVICE_ACCOUNT_NAME=cloud-run-sa

# Cloud Storage Configuration
GCS_BUCKET=${PROJECT_ID}-files

# Pub/Sub Configuration
PUBSUB_TOPIC=file-processing
PUBSUB_SUBSCRIPTION=file-processing-sub

# Optional: Add any other environment variables your application needs
# GOOGLE_APPLICATION_CREDENTIALS=path/to/your/credentials.json
